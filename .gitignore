# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

# Challenge material (slides, specs), not ours to redistribute
material/

# Pipeline run logs (regenerated on every run)
data/**/log_*.txt
# Re-downloadable source dump (opendata.swiss)
data/stapfer/*.sql.zip
data/stapfer/cases.json

# Jupyter / local tooling
.ipynb_checkpoints/
.claude/
Thumbs.db
desktop.ini
# Re-downloadable source files (fetched by the pipeline)
data/consultations/swissvotes_dataset.csv
# Scale-run intermediates (regenerable with src/scale_run.sh)
data/scale1000/records_raw.json
data/scale1000/classified.jsonl
data/scale1000/enriched.jsonl
data/scale1000/enrich_cache.json
# On-demand "See more" cache
data/more_cache/
data/scale1000/classified_unrepaired.jsonl

# per-model scratch caches of src/eval_features.py
data/model_eval/cache/

# store.py temp files (atomic writes; only left behind by a crash)
data/**/.*.tmp

# 10,000-record verification batch: not published, regenerable with src/batch_run.sh (docs/batch10k_verification.md)
data/batch10k/
# Consultation outcomes: Fedlex download (python src/run.py outcomes refetches it) and on-demand context
data/consultations/fedlex_acts.json
data/consultations/context_cache/

# Commons look-ups of the cover stage (covers.py; ~200 MB, rebuilt by python src/run.py covers)
data/covers_cache/
